{
  "ConnectionStrings": {
    "DefaultConnection": "Server=192.168.0.100;Port=5433;Database=morphus;User Id=morphus;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Jarbass": {
    "ServiceName": "Morphus Jarbass",
    "Workers": {
      "Catalog": {
        "Enabled": true,
        "IntervalSeconds": 60
      },
      "Email": {
        "Enabled": true,
        "IntervalSeconds": 10
      },
      "Workflow": {
        "Enabled": true,
        "IntervalSeconds": 15
      },
      "Maintenance": {
        "Enabled": true,
        "IntervalSeconds": 300
      }
    }
  }
}
