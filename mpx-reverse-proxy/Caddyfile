# Rota do ecossistema principal Morphus
{$MORPHUS_DOMAIN} {
	encode zstd gzip

	# Repassa chamadas de API para o container da API .NET
	handle /api/* {
		reverse_proxy mpx-backend:8080
	}

	# Repassa o tráfego restante para o servidor estático do Angular
	handle {
		reverse_proxy mpx-frontend:80
	}
}

# Rota camuflada para a central de automação com Inteligência Artificial
{$KALUPA_DOMAIN} {
	encode zstd gzip

	reverse_proxy mpx-kalupa:5678
}
