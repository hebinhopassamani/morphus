{
	email contact@morphus.one
}

# Rota do ecossistema principal Morphus e subdomínios oficiais (*.morphus.one)
{$MORPHUS_DOMAIN}, www.{$MORPHUS_DOMAIN}, cloud.{$MORPHUS_DOMAIN}, security.{$MORPHUS_DOMAIN}, flow.{$MORPHUS_DOMAIN}, send.{$MORPHUS_DOMAIN} {
	encode zstd gzip

	# Repassa chamadas de API para o container da API .NET
	handle /api/* {
		reverse_proxy mpx-backend:8080
	}

	# Repassa o tráfego restante para o servidor estático do Angular
	handle {
		reverse_proxy mpx-frontend:80
	}
}

# Rota para a central de automação Kalupa (n8n na porta 5678)
kalupa.{$MORPHUS_DOMAIN} {
	encode zstd gzip

	reverse_proxy mpx-kalupa:5678
}

# Redirecionamento oficial do portfólio de domínios Morphus para o ecossistema principal (morphus.one)
morphus.uk, www.morphus.uk, morphus.mx, www.morphus.mx, morphus.dev, www.morphus.dev, morphus.pro, www.morphus.pro, morphus.me, www.morphus.me {
	redir https://{$MORPHUS_DOMAIN}{uri} permanent
}

cloud.morphus.uk, cloud.morphus.mx, cloud.morphus.dev, cloud.morphus.pro, cloud.morphus.me {
	redir https://cloud.{$MORPHUS_DOMAIN}{uri} permanent
}

security.morphus.uk, security.morphus.mx, security.morphus.dev, security.morphus.pro, security.morphus.me {
	redir https://security.{$MORPHUS_DOMAIN}{uri} permanent
}

flow.morphus.uk, flow.morphus.mx, flow.morphus.dev, flow.morphus.pro, flow.morphus.me {
	redir https://flow.{$MORPHUS_DOMAIN}{uri} permanent
}

kalupa.morphus.uk, kalupa.morphus.mx, kalupa.morphus.dev, kalupa.morphus.pro, kalupa.morphus.me {
	redir https://kalupa.{$MORPHUS_DOMAIN}{uri} permanent
}

send.morphus.uk, send.morphus.mx, send.morphus.dev, send.morphus.pro, send.morphus.me {
	redir https://send.{$MORPHUS_DOMAIN}{uri} permanent
}
