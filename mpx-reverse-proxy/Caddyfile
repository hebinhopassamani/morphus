# Rota do ecossistema principal Morphus e subdomínios oficiais (*.morphus.one)
{$MORPHUS_DOMAIN}, www.{$MORPHUS_DOMAIN}, cloud.{$MORPHUS_DOMAIN}, security.{$MORPHUS_DOMAIN}, flow.{$MORPHUS_DOMAIN}, send.{$MORPHUS_DOMAIN} {
	encode zstd gzip

	# Repassa chamadas de API para o container da API .NET
	handle /api/* {
		reverse_proxy mpx-backend:8080
	}

	# Repassa o tráfego restante para o servidor estático do Angular
	handle {
		reverse_proxy mpx-frontend:80
	}
}

# Rota para a central de automação Kalupa (n8n na porta 5678)
kalupa.{$MORPHUS_DOMAIN} {
	encode zstd gzip

	reverse_proxy mpx-kalupa:5678
}
