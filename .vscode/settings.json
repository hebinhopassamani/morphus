{
    "editor.fontFamily": "Fira Code",
    "editor.fontSize": 20,
    "editor.fontLigatures": true,
    "editor.fontWeight": "300",
    "editor.lineHeight": 1.4,
    "editor.minimap.enabled": false,
    "editor.guides.indentation": false,
    "editor.emptySelectionClipboard": false,
    "editor.tabSize": 4,
    "editor.glyphMargin": false,
    "editor.formatOnPaste": false,
    "editor.formatOnType": false,
    "editor.formatOnSave": true,
    "editor.padding.top": 20,
    "editor.padding.bottom": 20,
    "editor.renderLineHighlight": "none",
    "editor.stickyScroll.enabled": false,
    "editor.lineNumbers": "off",
    "editor.suggest.selectionMode": "never",
    "editor.hover.delay": 800,
    "workbench.tree.renderIndentGuides": "none",
    "workbench.experimental.modernUI": true,
    "window.density.layout": "compact",    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "prettier.prettierPath": "./node_modules/prettier",
    "workbench.colorTheme": "Dracula Theme Soft",
    "workbench.iconTheme": "material-icon-theme",
    "workbench.activityBar.location": "default",
    "workbench.tree.indent": 18,
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "workbench.tree.enableStickyScroll": false,
    "terminal.integrated.initialHint": false,
    "terminal.integrated.defaultProfile.osx": "zsh",
    "terminal.integrated.defaultProfile.windows": "Git Bash",
    "terminal.integrated.cursorStyle": "block",
    "terminal.integrated.fontSize": 18,
    "terminal.integrated.fontFamily": "'Fira Code'",
    "terminal.integrated.fontLigatures.enabled": true,
    "js/ts.preferences.importModuleSpecifier": "non-relative",
    "js/ts.updateImportsOnFileMove.enabled": "never",
    "breadcrumbs.enabled": false,
    "explorer.compactFolders": false,
    "prettier.requireConfig": true,
    "diffEditor.renderSideBySide": false,
    "diffEditor.renderIndicators": false,
    "json.format.keepLines": true,
    "files.exclude": {
        ".gitignore": true,
        ".csharpierrc.json": true,
        "**/.prettierignore": true,
        "**/eslint.config.js": true,
        "**/*.md": true,
        "**/*.spec.ts": true,
        "**/e2e": true,
        "**/karma.conf.js": true,
        "**/package-lock.json": true,
        "**/test.ts": true,
        "**/tsconfig.spec.json": true,
        "**/tslint.json": true,
        "**/.config": true,
        "**/obj": true,
        "**/bin": true
    },
    "files.associations": {
        "*.css": "tailwindcss"
    },
    "[jsonc]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    }
}
