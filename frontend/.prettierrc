{
	"arrowParens": "avoid",
	"bracketSpacing": true,
	"htmlWhitespaceSensitivity": "ignore",
	"insertPragma": false,
	"singleAttributePerLine": false,
	"jsxBracketSameLine": true,
	"bracketSameLine": true,
	"jsxSingleQuote": true,
	"printWidth": 150,
	"quoteProps": "consistent",
	"requirePragma": false,
	"semi": true,
	"singleQuote": true,
	"tabWidth": 4,
	"trailingComma": "es5",
	"useTabs": true
}
