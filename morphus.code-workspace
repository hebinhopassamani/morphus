  // mantendo seu User Settings Global limpo.
  "settings": {
    // 1. Configurações de Formatação e Lint do Projeto (Preferências visuais/fontes vêm do User Settings Global)
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.detectIndentation": false,
    "editor.tabSize": 2,
    "prettier.requireConfig": true,
    "prettier.prettierPath": "./mpx-frontend/node_modules/prettier",
    "prettier.configPath": "./.prettierrc",
    "js/ts.preferences.importModuleSpecifier": "non-relative",
    "js/ts.updateImportsOnFileMove.enabled": "never",
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit",
    },
    "files.associations": {
      "*.css": "tailwindcss",
    },
    "files.exclude": {
      ".csharpierrc.json": true,
      "**/.prettierignore": true,
      "**/eslint.config.js": true,
      "**/*.spec.ts": true,
      "**/*.postcssrc.json": true,
      "**/*AGENTS.md": true,
      "**/*skills-lock.json": true,
      "**/*.env": true,
