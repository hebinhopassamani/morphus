# ==========================================
# 1. DEPENDÊNCIAS E BUILDS DO FRONTEND (Angular)
# ==========================================
**/node_modules/
**/.angular/
**/dist/
**/tmp/
**/out-tsc/
**/.sass-cache/

# ==========================================
# 2. COMPILAÇÃO E ARTEFATOS DO BACKEND (.NET Core)
# ==========================================
**/bin/
**/obj/
**/.vs/
**/*.user
**/*.userosscache
**/*.suo
**/*.userprefs

# ==========================================
# 3. CONFIGURAÇÕES E AMBIENTES (Morphus Globais)
# ==========================================
**/.env
**/.env.*
**/appsettings.local.json

# ==========================================
# 4. SISTEMA OPERACIONAL E LOGS
# ==========================================
.sass-cache/
.env
testem.log
**/.DS_Store
**/Thumbs.db
**/*.log
**/*.bak
**/.builderkit
**/.angular/cache
**/connect.lock
**/coverage
**/libpeerconnection.log
**/typings

# ==========================================
# 5. REGRAS DO EDITOR (Seu Setup Limpo)
# ==========================================
# Oculta arquivos locais do VS Code/Cursor da equipe, 
# mas permite compartilhar extensões se necessário
.vscode/*
!.vscode/extensions.json
